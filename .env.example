# Client-visible build configuration. Never put service-role or provider
# web-service secrets in an EXPO_PUBLIC_* value.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
EXPO_PUBLIC_APP_URL=https://your-production-domain.example
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Android Maps is required by the production config gate. The iOS key is
# optional because the current native map can use Apple Maps on iOS.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=your-restricted-android-key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=your-restricted-ios-key

# Licensed web-map style and required attribution.
EXPO_PUBLIC_MAP_STYLE_URL=https://your-licensed-map-provider.example/style.json
EXPO_PUBLIC_MAP_ATTRIBUTION=Map data provider
EXPO_PUBLIC_MAP_ATTRIBUTION_URL=https://your-map-provider.example/attribution

# Counsel-approved public policies and a staffed support destination. Production
# builds fail closed unless every URL is valid HTTPS.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-production-domain.example/privacy
EXPO_PUBLIC_TERMS_URL=https://your-production-domain.example/terms
EXPO_PUBLIC_COMMUNITY_RULES_URL=https://your-production-domain.example/community-rules
EXPO_PUBLIC_SUPPORT_URL=https://your-production-domain.example/support

# Fail-closed feature gates. Leave false until the matching release evidence in
# docs/RELEASE.md is complete.
EXPO_PUBLIC_HOME_KITCHENS_ENABLED=false
EXPO_PUBLIC_MEDIA_UPLOADS_ENABLED=false
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUBLIC_PICKUP_ORDERING_ENABLED=false
EXPO_PUBLIC_IN_APP_NAVIGATION_ENABLED=false
EXPO_PUBLIC_BUSINESS_CLAIMS_ENABLED=false
EXPO_PUBLIC_SPONSORED_PLACEMENTS_ENABLED=false

# Sites Worker runtime values. Configure these through Sites, not in the client
# bundle. Include every HTTPS style, tile, glyph, and sprite origin.
SPOTTR_MAP_CSP_ORIGINS=https://your-licensed-map-provider.example
SPOTTR_APPLE_TEAM_ID=your-apple-team-id
SPOTTR_IOS_BUNDLE_ID=com.spottr.food
SPOTTR_ANDROID_PACKAGE=com.spottr.food
SPOTTR_ANDROID_CERT_SHA256=AA:BB:CC:replace-with-release-certificate-fingerprint

# Server-only HMAC key used by the public-discovery Edge gateway. Never expose
# this value through EXPO_PUBLIC_* configuration or the application bundle.
SPOTTR_DISCOVERY_RATE_SECRET=replace-with-at-least-32-random-characters
SPOTTR_SPONSORED_PLACEMENTS_ENABLED=false
