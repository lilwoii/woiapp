{
  "name": "spottr-food",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-minimatch-brace-compat.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno check \"supabase/functions/**/index.ts\"",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:edge": "deno test --allow-read supabase/tests",
    "verify:production-config": "node scripts/verify-production-config-gate.mjs",
    "inventory:overture:extract": "node scripts/extract-overture-food.mjs",
    "export:web": "expo export --platform web",
    "build:sites": "npm run export:web && node scripts/prepare-sites-build.mjs",
    "build": "npm run build:sites",
    "validate": "npm run verify:build-assets && npm run typecheck && npm run typecheck:edge && npm run lint && npm run test:ci && npm run test:edge && npm run test:build-asset-tools && npm run test:native-release-tools && npm run test:maintenance-tools && npm run verify:production-config && npx expo-doctor && npx expo install --check && npm run verify:native-release && npm run build:sites",
    "test:native-release-tools": "node --test scripts/native-release-verifier.test.mjs",
    "verify:native-config": "node scripts/native-release-verifier.mjs --config",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:android": "expo export --platform android --output-dir dist-android",
    "verify:native-artifacts": "node scripts/native-release-verifier.mjs --artifacts",
    "verify:native-release": "npm run verify:native-config && npm run export:ios && npm run export:android && npm run verify:native-artifacts",
    "test:maintenance-tools": "node --test scripts/production-maintenance.test.mjs",
    "verify:build-assets": "node scripts/verify-build-assets.mjs",
    "test:build-asset-tools": "node --test scripts/verify-build-assets.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "maplibre-gl": "^5.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "deno": "^2.9.4",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.23",
    "uuid": "11.1.1",
    "ws": "8.21.1"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "lib/moderation.ts",
      "lib/chat-safety.ts",
      "lib/errors.ts",
      "lib/discovery-filters.ts",
      "lib/ordering-domain.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "private": true
}
