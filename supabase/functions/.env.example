SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SPOTTR_ALLOWED_ORIGINS=https://app.example.com

# Server-only HMAC key for the public-discovery gateway. Keep this out of all
# client-visible EXPO_PUBLIC_* configuration and rotate it as an operational
# secret, not as application data.
SPOTTR_DISCOVERY_RATE_SECRET=replace-with-at-least-32-random-characters
SPOTTR_SPONSORED_PLACEMENTS_ENABLED=false

# Keep both gates false until the external scanner, moderation queue, and
# operational deletion/retention drills have passed production acceptance.
SPOTTR_MEDIA_UPLOADS_ENABLED=false
SPOTTR_MEDIA_PIPELINE_ENABLED=false
SPOTTR_MEDIA_SCAN_SECRET=replace-with-at-least-32-random-characters
SPOTTR_MEDIA_CLEANUP_SECRET=replace-with-a-different-32-character-secret
SPOTTR_ACCOUNT_DELETE_WORKER_SECRET=replace-with-another-32-character-secret
SPOTTR_MEDIA_SCANNER_URL=https://scanner.example.com/v1/scan-and-reencode
SPOTTR_MEDIA_SCANNER_API_KEY=replace-with-at-least-32-random-characters

# Keep routing disabled until a production Mapbox Directions token is restricted,
# billing alerts/quotas are configured, and staging navigation acceptance passes.
SPOTTR_ROUTING_ENABLED=false
MAPBOX_DIRECTIONS_TOKEN=replace-with-server-only-mapbox-directions-token
SPOTTR_PUSH_DEVICE_REGISTRATION_ENABLED=false
SPOTTR_WEB_PUSH_DEVICE_REGISTRATION_ENABLED=false
SPOTTR_PUSH_EXPO_PROJECT_ID=00000000-0000-0000-0000-000000000000
# 32 random bytes encoded as unpadded base64url. Store only in the Edge secret manager.
SPOTTR_PUSH_TOKEN_ENCRYPTION_KEY=replace-with-43-character-base64url-secret
SPOTTR_PUSH_TOKEN_ENCRYPTION_KEY_VERSION=1
# Separate 32-byte base64url HMAC key for non-reversible token deduplication.
SPOTTR_PUSH_TOKEN_HASH_KEY=replace-with-different-43-character-base64url-secret
# Independent server-worker gates. Keep every value false until live provider,
# signed-device, receipt, scheduler, alerting, legal, and store acceptance passes.
SPOTTR_PUSH_DISPATCH_WORKER_ENABLED=false
SPOTTR_PUSH_RECEIPT_WORKER_ENABLED=false
SPOTTR_PUSH_EXPO_PROVIDER_ENABLED=false
SPOTTR_WEB_PUSH_PROVIDER_ENABLED=false
SPOTTR_PUSH_DISPATCH_SECRET=replace-with-a-dedicated-32-character-worker-secret
SPOTTR_PUSH_RECEIPT_SECRET=replace-with-a-different-32-character-worker-secret
# Enable Expo enhanced push security and store this token only in Edge secrets.
SPOTTR_PUSH_EXPO_ACCESS_TOKEN=replace-with-expo-enhanced-security-access-token
# Standards-based browser push. Restrict endpoint origins to the exact browser
# push services accepted during Chrome/Edge, Firefox, and Safari testing.
SPOTTR_WEB_PUSH_VAPID_SUBJECT=https://app.example.com/
SPOTTR_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-87-character-base64url-public-key
SPOTTR_WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-43-character-base64url-private-key
SPOTTR_WEB_PUSH_ALLOWED_ORIGINS=https://fcm.googleapis.com,https://updates.push.services.mozilla.com,https://web.push.apple.com
# JSON map of AES-GCM key versions to 32-byte unpadded base64url keys. Retain old
# versions until every device registration encrypted under them is retired.
SPOTTR_PUSH_TOKEN_ENCRYPTION_KEYS={"1":"replace-with-43-character-base64url-secret"}

# Stripe Connect hosted onboarding + Checkout for restaurant/food-truck pickup.
# The client/server/database gates remain false until live Connect onboarding,
# webhook, tax, refund, reconciliation, and physical-device acceptance pass.
SPOTTR_PREPAID_PICKUP_ENABLED=false
STRIPE_SECRET_KEY=replace-with-server-only-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-server-only-stripe-webhook-secret
SPOTTR_APP_ORIGIN=https://app.example.com
SPOTTR_STRIPE_CONNECT_COUNTRIES=US
SPOTTR_PAYMENT_REFUND_WORKER_ENABLED=false
SPOTTR_PAYMENT_REFUND_WORKER_SECRET=replace-with-a-dedicated-32-character-refund-worker-secret
